{
  "name": "ink-stone-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "_comment": "On Windows the '&' in the folder name (Ink & Stone) breaks the .cmd shims. We work around it by calling the node binaries directly.",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:pwa": "VITE_PWA_DEV=1 node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "build:e2e": "VITE_SUPABASE_URL=https://e2e.supabase.co VITE_SUPABASE_ANON_KEY=e2e-anon-key node ./node_modules/vite/bin/vite.js build --outDir dist-e2e",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test:e2e": "node ./node_modules/playwright/cli.js test -c playwright.config.ts"
  },
  "dependencies": {
    "@sigma/node-border": "^3.0.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.29.2",
    "d3-force": "^3.0.0",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "framer-motion": "^12.38.0",
    "graphology": "^0.26.0",
    "idb": "8.0.4",
    "lucide-react": "^0.562.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "4.2.0",
    "sigma": "^3.0.3",
    "yaml": "2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^5.0.1"
  }
}
