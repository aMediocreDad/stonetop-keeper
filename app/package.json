{
  "name": "ink-stone-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "_comment": "On Windows the '&' in the folder name (Ink & Stone) breaks the .cmd shims. We work around it by calling the node binaries directly.",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:pwa": "VITE_PWA_DEV=1 node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "build:e2e": "VITE_SUPABASE_URL=https://e2e.supabase.co VITE_SUPABASE_ANON_KEY=e2e-anon-key node ./node_modules/vite/bin/vite.js build --outDir dist-e2e",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test:e2e": "node ./node_modules/playwright/cli.js test -c playwright.config.ts"
  },
  "dependencies": {
    "@sigma/node-border": "^3.0.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tiptap/extension-mention": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "d3-force": "^3.0.0",
    "dompurify": "3.4.13",
    "fflate": "0.8.3",
    "framer-motion": "^12.38.0",
    "graphology": "^0.26.0",
    "idb": "8.0.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0",
    "react-zoom-pan-pinch": "4.0.3",
    "sigma": "^3.0.3",
    "yaml": "2.9.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.8"
  }
}
